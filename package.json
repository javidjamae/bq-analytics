{
  "name": "bq-analytics",
  "version": "0.4.0",
  "description": "Use BigQuery as a product analytics backend: one events table, typed tracking, and an ingestion handler you can mount in any framework.",
  "license": "MIT",
  "author": "Javid Jamae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javidjamae/bq-analytics.git"
  },
  "homepage": "https://github.com/javidjamae/bq-analytics#readme",
  "bugs": {
    "url": "https://github.com/javidjamae/bq-analytics/issues"
  },
  "keywords": [
    "analytics",
    "bigquery",
    "product-analytics",
    "events",
    "tracking"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./schema/events.schema.json": "./schema/events.schema.json",
    "./schema/events.ddl.sql": "./schema/events.ddl.sql"
  },
  "files": [
    "dist",
    "schema",
    "sql",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/__tests__/*.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "release": "node scripts/release.mjs",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@google-cloud/bigquery": ">=7"
  },
  "peerDependenciesMeta": {
    "@google-cloud/bigquery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
